#!/sbin/openrc-run
description="Podroid system migrations (immutable indexed upgrade hooks)"

# Run before all other Podroid bringup. The initramfs has already mounted the
# read-only squashfs at /mnt/lower and authoritative ext4 at /mnt/persist.
depend() {
    need localmount
    before podroid-bootstrap
}

start() {
    ebegin "Running Podroid migrations"
    # Invoke the runner and scripts only through the immutable lower mount. The
    # merged /etc tree may contain persistent copy-ups and is not trusted as code.
    if /mnt/lower/usr/local/bin/podroid-migrate-runner \
        /mnt/lower /mnt/persist / > /dev/console 2>&1; then
        eend 0
        return 0
    fi
    eend 1 "migration runner failed"
    return 1
}
