#!/sbin/openrc-run
description="Podroid VM networking (QEMU SLIRP static address or AVF DHCP)"

depend() {
    need podroid-bootstrap
    before podroid-ready dropbear
    provide net
}

start() {
    ebegin "Configuring network..."
    echo "Configuring network..." > /dev/console
    ip link set lo up 2>/dev/null

    NETIF=""
    for _i in $(seq 1 10); do
        NETIF=$(ip -o link show 2>/dev/null | awk -F': ' '$2 != "lo" {print $2; exit}')
        NETIF=${NETIF%%@*}
        [ -n "$NETIF" ] && break
        sleep 0.05
    done
    if [ -z "$NETIF" ]; then
        eend 1 "no network interface"
        return 1
    fi
    ip link set "$NETIF" up

    if grep -q 'podroid\.backend=avf' /proc/cmdline 2>/dev/null; then
        # AVF networking is assigned by Android's tethering DHCP service. Keep
        # the request bounded to eight one-second attempts and fail visibly if
        # no address is assigned.
        udhcpc -i "$NETIF" -t 8 -T 1 -A 1 -q -f -n 2>/dev/null || true
        [ -s /etc/resolv.conf ] || \
            printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\n' > /etc/resolv.conf
        if ! ip -o -4 addr show dev "$NETIF" 2>/dev/null | grep -q 'inet '; then
            eend 1 "DHCP did not assign an address to $NETIF"
            return 1
        fi
    else
        # QEMU uses the stable SLIRP subnet and DNS endpoint.
        ip addr add 10.0.2.15/24 dev "$NETIF" 2>/dev/null || true
        ip route replace default via 10.0.2.2 dev "$NETIF"
        printf 'nameserver 10.0.2.3\nnameserver 8.8.8.8\nnameserver 1.1.1.1\n' \
            > /etc/resolv.conf
        if ! ip -o -4 addr show dev "$NETIF" 2>/dev/null | grep -q 'inet '; then
            eend 1 "static IP did not stick on $NETIF"
            return 1
        fi
    fi

    BW_MBIT=$(sed -n 's/.*podroid\.bandwidth=\([0-9]*\).*/\1/p' /proc/cmdline 2>/dev/null)
    if [ -n "$BW_MBIT" ] && [ "$BW_MBIT" -gt 0 ]; then
        tc qdisc replace dev "$NETIF" root tbf rate "${BW_MBIT}mbit" \
            burst 32kbit latency 400ms 2>/dev/null || true
    fi

    echo "Network found" > /dev/console
    eend 0
}
