#!/sbin/openrc-run
description="Podroid VM system bootstrap (mounts, modules, cgroup2, ZRAM)"

depend() {
    need localmount podroid-migrate
    before podroid-network
}

start() {
    ebegin "Loading kernel modules..."
    echo "Loading kernel modules..." > /dev/console

    # AVF does not provide the emulated RTC used by QEMU. Android supplies a
    # wall-clock seed so TLS validation for apk and Dropbear is usable at boot.
    PODROID_EPOCH=$(sed -n 's/.*podroid\.epoch=\([0-9]*\).*/\1/p' /proc/cmdline)
    if [ -n "$PODROID_EPOCH" ] && [ "$PODROID_EPOCH" -gt 0 ] 2>/dev/null; then
        date -s "@$PODROID_EPOCH" >/dev/null 2>&1
    fi

    # Keep the root mount propagation-ready for future guest overlay/workload
    # orchestration without coupling the base image to a runtime implementation.
    mount --make-rshared / 2>/dev/null

    mkdir -p /dev/pts /dev/shm /dev/mqueue 2>/dev/null
    mountpoint -q /dev/pts || mount -t devpts \
        -o gid=5,mode=0620,ptmxmode=0666,noexec,nosuid devpts /dev/pts
    mountpoint -q /dev/shm || mount -t tmpfs \
        -o noexec,nosuid,nodev,size=64m tmpfs /dev/shm
    mountpoint -q /dev/mqueue || mount -t mqueue \
        -o noexec,nosuid,nodev mqueue /dev/mqueue
    [ -c /dev/ptmx ] || mknod /dev/ptmx c 5 2 2>/dev/null
    chmod 0666 /dev/ptmx /dev/pts/ptmx 2>/dev/null

    [ -r /etc/hostname ] && hostname -F /etc/hostname 2>/dev/null

    depmod -a 2>/dev/null
    for module in 9p 9pnet 9pnet_virtio; do
        modprobe "$module" 2>/dev/null
    done

    for scheduler in /sys/block/vda/queue/scheduler /sys/block/vdb/queue/scheduler; do
        [ -w "$scheduler" ] && echo mq-deadline > "$scheduler" 2>/dev/null
    done

    # QEMU Downloads sharing uses virtio-9p. AVF mounts its 9p-over-vsock share
    # from podroid-downloads instead. A disabled QEMU share fails silently here.
    if ! grep -q 'podroid\.backend=avf' /proc/cmdline 2>/dev/null; then
        mkdir -p /mnt/downloads 2>/dev/null
        mount -t 9p -o trans=virtio,version=9p2000.L,rw,msize=262144,cache=mmap,noatime \
            downloads /mnt/downloads 2>/dev/null
    fi

    # Preserve bounded device prerequisites for future guest overlays and
    # orchestrated networking. These nodes grant no Android host privilege.
    mkdir -p /dev/net 2>/dev/null
    [ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200 2>/dev/null
    [ -c /dev/fuse ] || mknod /dev/fuse c 10 229 2>/dev/null
    chmod 0666 /dev/net/tun /dev/fuse 2>/dev/null

    mkdir -p /sys/fs/cgroup 2>/dev/null
    mountpoint -q /sys/fs/cgroup || mount -t cgroup2 cgroup2 /sys/fs/cgroup
    printf '+cpuset +cpu +io +memory +hugetlb +pids +rdma\n' \
        > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null

    # Keep compressed swap available for general guest memory pressure. The
    # operation is naturally bounded at 1.5x detected guest RAM.
    if [ -b /dev/zram0 ]; then
        mem_kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
        echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null
        echo $((mem_kb * 1536)) > /sys/block/zram0/disksize 2>/dev/null
        mkswap /dev/zram0 >/dev/null 2>&1 && swapon -p 100 /dev/zram0 2>/dev/null
    fi

    # Basic OOM policy: select a victim by badness and permit address-space
    # overcommit so ordinary guest processes reach the OOM policy consistently.
    [ -w /proc/sys/vm/oom_kill_allocating_task ] && \
        echo 0 > /proc/sys/vm/oom_kill_allocating_task
    [ -w /proc/sys/vm/overcommit_memory ] && \
        echo 1 > /proc/sys/vm/overcommit_memory

    # Forwarding remains a prerequisite for future orchestrators and explicit
    # guest workloads; no bridge or predefined workload service is created.
    sysctl -qw net.ipv4.ip_forward=1 \
        net.ipv4.conf.all.forwarding=1 \
        net.ipv6.conf.all.forwarding=1 \
        net.ipv6.conf.default.forwarding=1 2>/dev/null

    eend 0
}
