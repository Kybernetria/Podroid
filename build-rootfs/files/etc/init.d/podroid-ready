#!/sbin/openrc-run
description="Podroid VM ready marker (consumed by Android boot detector)"

depend() {
    need podroid-network
    # Guest overlay enrollment and control-plane reachability are optional.
    # Do not order Ready behind tailscale or its bounded reconnect one-shot.
    after dropbear podroid-vsock podroid-hostd
}

start() {
    # Keep the remote-access and Android control plane available under ordinary
    # guest memory pressure. This is a bounded scan of three process names.
    for name in dropbear podroid-vsock-agent podroid-hostd; do
        for pid in $(pgrep -x "$name" 2>/dev/null); do
            echo -1000 > "/proc/$pid/oom_score_adj" 2>/dev/null
        done
    done

    # Preserve the backend-neutral boot-stage contract consumed by Android.
    echo "Starting SSH..." > /dev/console
    echo "Almost ready..." > /dev/console
    echo "Ready!" > /dev/console
    return 0
}

stop() {
    return 0
}
