#!/bin/sh
set -eu
export LC_ALL=C

if [ -n "${PODROID_TAILSCALE_TEST_ROOT:-}" ]; then
    COMMON="$PODROID_TAILSCALE_TEST_ROOT/usr/local/libexec/podroid-tailscale-common"
else
    COMMON=/usr/local/libexec/podroid-tailscale-common
fi
# shellcheck source=/dev/null
. "$COMMON"
podroid_tailscale_init_paths
podroid_tailscale_require_client

umask 077
STATUS_FILE=$(mktemp "$PODROID_RUN_DIR/podroid-tailscale-status.XXXXXX") || exit 1
cleanup() {
    trap - EXIT HUP INT TERM
    rm -f -- "$STATUS_FILE"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if ! timeout 10 "$PODROID_TAILSCALE_BIN" --socket="$PODROID_TAILSCALE_SOCKET" status --json > "$STATUS_FILE" 2>/dev/null; then
    echo "tailscale status unavailable" >&2
    exit 1
fi
status_bytes=$(wc -c < "$STATUS_FILE")
[ "$status_bytes" -le 262144 ] || {
    echo "tailscale status exceeds 256 KiB" >&2
    exit 1
}
cat "$STATUS_FILE"
