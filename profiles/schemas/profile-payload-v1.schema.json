{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podroid.invalid/schemas/profile-payload-v1.schema.json",
  "title": "Podroid signed VM profile payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "profile_id", "generation", "data_compatibility", "architecture",
    "boot_contract", "storage_contract", "health_contract", "supported_backends", "artifacts"
  ],
  "properties": {
    "version": { "const": 1 },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 64 },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775806 },
    "data_compatibility": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 64 },
    "architecture": { "const": "aarch64" },
    "boot_contract": { "const": "podroid-direct-v1" },
    "storage_contract": { "const": "podroid-overlay-ext4-v1" },
    "health_contract": { "const": "podroid-ready-v1" },
    "supported_backends": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["qemu", "avf"] }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "url", "sha256", "size_bytes"],
        "properties": {
          "role": { "enum": ["kernel", "initrd", "rootfs"] },
          "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 }
        }
      }
    }
  }
}
